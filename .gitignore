# Local research data and all prior workspace artifacts are private by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/VALIDATION.md
!/pyproject.toml
!/requirements.lock
!/package.json
!/skills/
!/scripts/
!/templates/
!/examples/
!/tests/
!/.github/
/skills/*
!/skills/lab-rd/
/scripts/*
!/scripts/*.py
!/scripts/*.md
!/scripts/*.mjs
!/scripts/sync_codex_skills.ps1
/templates/*
!/templates/monthly-summary.xlsx
!/templates/project-context.yaml
**/__pycache__/
**/*.pyc
**/.venv/
**/node_modules/
**/local.json
**/installation.json
**/*.egg-info/
